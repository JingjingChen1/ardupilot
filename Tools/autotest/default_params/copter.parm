# ============================================================================
# 第五部分：PID控制参数（文件末尾，来源于初始值）
# ============================================================================
# ⚠️ 重要说明：
# - 这些是基于理论计算的初始PID值，适用于首次飞行
# - 不使用实机调试后的PID值，因为需要通过仿真或实飞重新验证
# - 对于同型号飞机，可作为调参起点，但仍需微调

# -----------------------------
# 5.1 姿态角速度控制环（最内环）
# -----------------------------
# 说明：控制Roll/Pitch/Yaw的角速度，直接作用于电机输出
# 调试优先级：最高（必须先调稳）
# 调试方法：逐步增大P值直到出现高频震荡，回退20%

# --- Roll角速度环 ---
ATC_RAT_RLL_P,0.135                # P增益（基准值，500mm机架）
ATC_RAT_RLL_I,0.135                # I增益（通常=P）
ATC_RAT_RLL_D,0.0036               # D增益（通常=P/30 ~ P/50）
ATC_RAT_RLL_IMAX,0.5               # I限幅（0-1，防积分饱和）
ATC_RAT_RLL_FF,0                   # 前馈增益（0=禁用）
ATC_RAT_RLL_FLTD,20.0              # D项低通滤波 Hz
ATC_RAT_RLL_FLTT,20.0              # 目标角速度低通滤波 Hz
ATC_RAT_RLL_FLTE,0                 # 误差低通滤波 Hz（0=禁用）
ATC_RAT_RLL_SMAX,0                 # 最大转速限制 deg/s（0=禁用）
ATC_RAT_RLL_PDMX,0                 # PD最大输出（0=无限制）
ATC_RAT_RLL_D_FF,0                 # D前馈（0=禁用）
ATC_RAT_RLL_NTF,0                  # 陷波滤波器频率 Hz（0=禁用）
ATC_RAT_RLL_NEF,0                  # 陷波滤波器误差频率

# --- Pitch角速度环 ---
ATC_RAT_PIT_P,0.135
ATC_RAT_PIT_I,0.135
ATC_RAT_PIT_D,0.0036
ATC_RAT_PIT_IMAX,0.5
ATC_RAT_PIT_FF,0
ATC_RAT_PIT_FLTD,20.0
ATC_RAT_PIT_FLTT,20.0
ATC_RAT_PIT_FLTE,0
ATC_RAT_PIT_SMAX,0
ATC_RAT_PIT_PDMX,0
ATC_RAT_PIT_D_FF,0
ATC_RAT_PIT_NTF,0
ATC_RAT_PIT_NEF,0

# --- Yaw角速度环 ---
ATC_RAT_YAW_P,0.18                 # Yaw的P值通常略高于Roll/Pitch
ATC_RAT_YAW_I,0.018                # I值约为P的1/10
ATC_RAT_YAW_D,0                    # Yaw一般不用D（避免噪声）
ATC_RAT_YAW_IMAX,0.5
ATC_RAT_YAW_FF,0
ATC_RAT_YAW_FLTD,20.0
ATC_RAT_YAW_FLTT,20.0
ATC_RAT_YAW_FLTE,2.5               # Yaw误差滤波略低
ATC_RAT_YAW_SMAX,0
ATC_RAT_YAW_PDMX,0
ATC_RAT_YAW_D_FF,0
ATC_RAT_YAW_NTF,0
ATC_RAT_YAW_NEF,0

