# --- 安全与保护 ---
# 解锁检查
ARMING_CHECK,1                     # 解锁检查：1=全部启用（推荐）
ARMING_ACCTHRESH,0.75              # 加速度阈值 m/s²（倾斜检查）
ARMING_MAGTHRESH,100               # 罗盘一致性阈值
ARMING_RUDDER,2                    # 舵机解锁：2=启用
ARMING_MIS_ITEMS,0                 # 任务项检查：0=禁用
ARMING_OPTIONS,0                   # 解锁选项
ARMING_CRSDP_IGN,0                 # CRSF深包忽略

# 失控保护
FS_THR_ENABLE,1                    # 油门失控保护：1=启用RTL
FS_THR_VALUE,975                   # 失控判定PWM值
FS_GCS_ENABLE,0                    # 地面站失联保护：0=禁用（⚠️ 建议改为1）
FS_GCS_TIMEOUT,5                   # 地面站失联超时 s
FS_EKF_ACTION,1                    # EKF失效动作：1=Land
FS_EKF_THRESH,0.8                  # EKF失效阈值
FS_EKF_FILT,5                      # EKF失效滤波
FS_DR_ENABLE,2                     # 动态返航失控：2=启用RTL
FS_DR_TIMEOUT,30                   # 动态返航超时 s
FS_CRASH_CHECK,1                   # 碰撞检测：1=启用
FS_VIBE_ENABLE,1                   # 振动失控：1=启用
FS_OPTIONS,16                      # 失控选项

# 电池失控保护（新增）
BATT_FS_LOW_ACT,0                  # 低电压动作（由FS_BATT处理）
BATT_FS_CRT_ACT,0                  # 严重低压动作
BATT_FS_VOLTSRC,0                  # 失控电压源

# 安全开关配置
BRD_SAFETY_DEFLT,0                 # 安全开关默认状态：0=禁用（无物理按钮）
BRD_SAFETY_MASK,16368              # 安全开关控制的通道掩码
BRD_SAFETYOPTION,3                 # 安全选项：3=解锁前允许油门

# 解锁延迟
DISARM_DELAY,10                    # 自动解锁延迟 s

# --- 地理围栏 ---
FENCE_ENABLE,0                     # 地理围栏：0=禁用（首飞后建议启用）
FENCE_TYPE,7                       # 围栏类型：7=圆柱体（水平+垂直）
