# ============================================================================
# SITL仿真专用物理参数（真机飞行时删除此部分）
# ============================================================================
# 说明：这些参数仅用于仿真环境，定义飞机的物理特性和传感器噪声
# 真机使用实际传感器数据，不需要这些参数

# --- 机体物理特性 ---
SIM_MASS,1.5                       # 总质量 kg（机架+飞控+电机+电池+其他）
                                   # 估算：机架200g + 飞控100g + 电机280g + 电池718g + 其他202g
SIM_ROLL_INERTIA,0.0125            # 横滚轴转动惯量 kg·m²（需实测或CAD计算）
SIM_PITCH_INERTIA,0.0125           # 俯仰轴转动惯量 kg·m²
SIM_YAW_INERTIA,0.0230             # 偏航轴转动惯量 kg·m²（≈Ixx+Iyy）
SIM_WHEELBASE,0.5                  # 轴距 m（S500机架规格）

# --- 重心位置（相对飞控） ---
SIM_CG_X,0.0                       # 重心X偏移 m
SIM_CG_Y,0.0                       # 重心Y偏移 m
SIM_CG_Z,0.02                      # 重心Z偏移 m（电池在下方约2cm）

# --- 螺旋桨参数 ---
SIM_PROP_DIAMETER,9.5              # 螺旋桨直径 英寸（9450桨）
SIM_PROP_PITCH,4.5                 # 螺旋桨螺距 英寸

# --- 传感器噪声仿真（模拟真实传感器特性）---
SIM_ACC_RND,0.3                    # 加速度计随机噪声 m/s²（ICM-42688典型值）
SIM_GYR_RND,0.01                   # 陀螺仪随机噪声 rad/s
SIM_BARO_RND,0.5                   # 气压计噪声（等效高度噪声 m）
SIM_BARO_DRIFT,0.02                # 气压计漂移率 Pa/s
SIM_GPS_DELAY,200                  # GPS数据延迟 ms（U-blox M9N典型值）
SIM_GPS_TYPE,1                     # 仿真GPS类型：1=UBLOX
SIM_GPS_NUMSATS,16                 # 仿真卫星数量
SIM_GPS_HACC,1.5                   # 水平精度 m（M9N规格）
SIM_GPS_VACC,2.5                   # 垂直精度 m

# --- 电机仿真 ---
SIM_MOTOR_HOVER,0.35               # 悬停油门比例（初始估算，实飞后自动学习）
SIM_ENGINE_MUL,1.0                 # 电机效率倍数（1.0=100%）

# --- 气动阻力系数 ---
SIM_DRAG_X,0.08                    # X轴阻力系数（前后）
SIM_DRAG_Y,0.08                    # Y轴阻力系数（左右）
SIM_DRAG_Z,0.15                    # Z轴阻力系数（垂直，桨盘阻力）

# --- 地面效应 ---
SIM_GND_EFFECT,1.0                 # 地面效应强度（1.0=启用）
SIM_GND_HGT,1.5                    # 地面效应影响高度 m

# --- SITL电池仿真 ---
SIM_BATT_VOLTAGE,12.6              # 仿真初始电压 V
SIM_BATT_CAP_AH,10.0               # 仿真电池容量 Ah
SIM_BATT_RESISTANCE,0.01           # 电池内阻 Ω

# ============================================================================
# 第一部分：硬件配置参数（来源于实机参数文件）
# ============================================================================
# 说明：这些参数定义了飞机的硬件拓扑和基本配置
# 从"pixhawk6X+S500调试好.param"提取，保证与实机一致

# --- 机架定义 ---
FRAME_CLASS,1                      # 机架类别：1=四旋翼
FRAME_TYPE,1                       # 机架类型：1=X型

# --- 电机与ESC配置 ---
MOT_PWM_TYPE,0                     # ESC协议：0=标准PWM（乐天20A）
MOT_PWM_MIN,1000                   # 电机最小PWM值
MOT_PWM_MAX,2000                   # 电机最大PWM值
MOT_SPIN_MIN,0.15                  # 最小稳定转速比例（实机实测值）
MOT_SPIN_MAX,0.95                  # 最大转速比例
MOT_SPIN_ARM,0                     # 解锁怠速（0=使用SPIN_MIN）
MOT_SPOOL_TIME,0.5                 # 电机加速时间 s
MOT_SLEW_UP_TIME,0                 # 电机向上加速时间（0=禁用限制）
MOT_SLEW_DN_TIME,0                 # 电机向下减速时间
MOT_THST_EXPO,0.65                 # 推力曲线指数（9450桨经验值）
MOT_YAW_HEADROOM,200               # Yaw轴预留控制裕度
MOT_SAFE_DISARM,0                  # 安全解锁：0=标准行为
MOT_SAFE_TIME,1                    # 安全解锁时间 s
MOT_OPTIONS,0                      # 电机选项
MOT_BOOST_SCALE,0                  # 油门提升比例

# 电机输出通道映射（X型四旋翼）
SERVO1_FUNCTION,33                 # 输出1 = 电机1（右前）
SERVO1_MIN,1100
SERVO1_MAX,1900
SERVO1_TRIM,1500
SERVO1_REVERSED,0

SERVO2_FUNCTION,34                 # 输出2 = 电机2（左后）
SERVO2_MIN,1100
SERVO2_MAX,1900
SERVO2_TRIM,1500
SERVO2_REVERSED,0

SERVO3_FUNCTION,35                 # 输出3 = 电机3（左前）
SERVO3_MIN,1100
SERVO3_MAX,1900
SERVO3_TRIM,1500
SERVO3_REVERSED,0

SERVO4_FUNCTION,36                 # 输出4 = 电机4（右后）
SERVO4_MIN,1100
SERVO4_MAX,1900
SERVO4_TRIM,1500
SERVO4_REVERSED,0

# 其他输出通道（未使用）
SERVO5_FUNCTION,0
SERVO6_FUNCTION,0
SERVO7_FUNCTION,0
SERVO8_FUNCTION,0
SERVO9_FUNCTION,0
SERVO10_FUNCTION,0
SERVO11_FUNCTION,0
SERVO12_FUNCTION,0
SERVO13_FUNCTION,0
SERVO14_FUNCTION,0
SERVO15_FUNCTION,0
SERVO16_FUNCTION,0

# 舵机刷新率
SERVO_RATE,50                      # 舵机刷新率 Hz（电机用）
SERVO_DSHOT_RATE,0                 # DShot刷新率（当前使用PWM，设为0）
SERVO_RC_FS_MSK,0                  # 遥控失控时舵机掩码

# --- 电池监测配置（⚠️ 已修改为TATTU 10000mAh）---
BATT_MONITOR,21                    # 监测类型：21=DroneCAN（PM07模块）
BATT_CAPACITY,10000                # ✅ 修改：电池容量 mAh（原值5200，已更正）
BATT_I2C_BUS,1                     # I2C总线号
BATT_I2C_ADDR,0                    # I2C地址（0=自动）
BATT_SHUNT,0.0005                  # 分流电阻 Ω（PM07规格）
BATT_MAX_AMPS,90                   # 最大电流 A（保护阈值）

# 电池电压保护阈值
BATT_LOW_VOLT,10.5                 # 低电压警告 V（3.5V/cell × 3S）
BATT_CRT_VOLT,9.9                  # ✅ 新增：严重低压 V（3.3V/cell，强制降落）
BATT_LOW_MAH,2000                  # ✅ 新增：低容量警告 mAh（剩余20%）
BATT_CRT_MAH,1000                  # ✅ 新增：严重低容量 mAh（剩余10%）
BATT_LOW_TIMER,10                  # 低电压延迟 s

BATT_ARM_VOLT,0                    # 解锁最低电压（0=禁用）
BATT_ARM_MAH,0                     # 解锁最低容量（0=禁用）
BATT_FS_LOW_ACT,0                  # 低电压失控动作（0=无动作，由FS_BATT处理）
BATT_FS_CRT_ACT,0                  # 严重低压失控动作
BATT_FS_VOLTSRC,0                  # 失控电压源：0=原始电压
BATT_OPTIONS,0                     # 电池选项
BATT_SERIAL_NUM,-1                 # 电池序列号（-1=禁用）

# 电池电压电流比例（PM07默认值，通常无需修改）
MOT_BAT_VOLT_MAX,0                 # 电机油门补偿最大电压（0=使用BATT参数）
MOT_BAT_VOLT_MIN,0                 # 电机油门补偿最小电压
MOT_BAT_CURR_MAX,0                 # 最大电流限制（0=禁用）
MOT_BAT_CURR_TC,5                  # 电流时间常数 s
MOT_BAT_IDX,0                      # 使用的电池索引（0=BATT1）

# 其他电池监测器（禁用）
BATT2_MONITOR,0
BATT3_MONITOR,0
BATT4_MONITOR,0
BATT5_MONITOR,0
BATT6_MONITOR,0
BATT7_MONITOR,0
BATT8_MONITOR,0
BATT9_MONITOR,0

# --- GPS配置 ---
GPS_TYPE,1                         # GPS类型：1=AUTO（自动检测U-blox M9N）
GPS_TYPE2,0                        # 第二GPS：0=禁用
GPS_AUTO_CONFIG,1                  # 自动配置GPS
GPS_AUTO_SWITCH,1                  # GPS自动切换
GPS_BLEND_MASK,5                   # GPS混合掩码
GPS_NAVFILTER,8                    # 导航滤波器：8=Airborne<1g（多旋翼）
GPS_RATE_MS,200                    # GPS更新率 ms（5Hz）
GPS_RATE_MS2,200                   # GPS2更新率
GPS_DELAY_MS,0                     # GPS延迟（0=自动）
GPS_DELAY_MS2,0                    # GPS2延迟
GPS_HDOP_GOOD,140                  # HDOP良好阈值（1.4）
GPS_MIN_DGPS,100                   # 差分GPS最小精度
GPS_MIN_ELEV,-100                  # 最低卫星仰角 °
GPS_PRIMARY,0                      # 主GPS选择（0=第一个可用）
GPS_SAVE_CFG,2                     # 保存GPS配置：2=每次启动
GPS_SBAS_MODE,2                    # SBAS模式：2=启用
GPS_GNSS_MODE,0                    # GNSS模式（0=默认）
GPS_GNSS_MODE2,0                   # GPS2 GNSS模式
GPS_DRV_OPTIONS,0                  # GPS驱动选项
GPS_RAW_DATA,0                     # 原始数据输出：0=禁用
GPS_INJECT_TO,127                  # RTCM注入目标
GPS_SBP_LOGMASK,-256               # SBP日志掩码

# GPS CAN节点ID（DroneCAN GPS时使用）
GPS_CAN_NODEID1,0
GPS_CAN_NODEID2,0
GPS1_CAN_OVRIDE,0
GPS2_CAN_OVRIDE,0

# GPS天线位置（相对飞控）
GPS_POS1_X,0                       # GPS1 X偏移 m
GPS_POS1_Y,0                       # GPS1 Y偏移 m
GPS_POS1_Z,0                       # GPS1 Z偏移 m（负值=向上）
GPS_POS2_X,0                       # GPS2位置
GPS_POS2_Y,0
GPS_POS2_Z,0

# GPS_MB（Moving Baseline，双GPS时使用）
GPS_MB1_TYPE,0                     # MB1类型：0=禁用
GPS_MB2_TYPE,0

# GPS通信端口
GPS_COM_PORT,1                     # GPS1通信端口
GPS_COM_PORT2,1                    # GPS2通信端口

# --- 罗盘配置（硬件定义部分）---
COMPASS_ENABLE,1                   # 启用罗盘
COMPASS_EXTERNAL,1                 # 使用外置罗盘（GPS模块集成）
COMPASS_ORIENT,6                   # 罗盘安装方向：6=Yaw270°（实机实测）
COMPASS_ORIENT2,0                  # 罗盘2方向：0=无旋转
COMPASS_ORIENT3,0                  # 罗盘3方向
COMPASS_USE,1                      # 启用罗盘1
COMPASS_USE2,0                     # 禁用罗盘2（已校准但未使用）
COMPASS_USE3,0                     # 禁用罗盘3
COMPASS_DISBLMSK,0                 # 罗盘禁用掩码

# 罗盘学习和自动旋转
COMPASS_LEARN,0                    # 罗盘学习：0=禁用
COMPASS_AUTO_ROT,2                 # 自动旋转：2=完全自动
COMPASS_AUTODEC,1                  # 自动磁偏角：1=启用
COMPASS_DEC,0                      # 手动磁偏角（启用AUTO时忽略）

# 罗盘校准参数（高级）
COMPASS_CAL_FIT,16                 # 校准拟合质量阈值
COMPASS_OFFS_MAX,1800              # 最大偏移值 mGauss
COMPASS_FLTR_RNG,0                 # 滤波范围
COMPASS_OPTIONS,0                  # 罗盘选项

# 罗盘电机干扰补偿
COMPASS_PMOT_EN,0                  # 电机补偿：0=禁用
COMPASS_MOTCT,0                    # 电机补偿类型
COMPASS_MOT_X,0                    # 电机补偿系数X
COMPASS_MOT_Y,0
COMPASS_MOT_Z,0
COMPASS_MOT2_X,0
COMPASS_MOT2_Y,0
COMPASS_MOT2_Z,0
COMPASS_MOT3_X,0
COMPASS_MOT3_Y,0
COMPASS_MOT3_Z,0

# 罗盘比例因子（通常为0，禁用）
COMPASS_SCALE,0
