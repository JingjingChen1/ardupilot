# ============================================================================

SIM_SPEEDUP      1.0

# IMU日志记录
INS_LOG_BAT_MASK 3
INS_LOG_BAT_CNT  1024
INS_LOG_BAT_LGCT 32
INS_LOG_BAT_LGIN 20
INS_LOG_BAT_OPT  4
INS_RAW_LOG_OPT  0

# --- 日志记录 ---
LOG_BACKEND_TYPE 1
LOG_FILE_BUFSIZE 200
LOG_FILE_DSRMROT 0
LOG_FILE_MB_FREE 500
LOG_FILE_TIMEOUT 5
LOG_FILE_RATEMAX 0
LOG_MAV_BUFSIZE  8
LOG_MAV_RATEMAX  0
LOG_BITMASK      180222
LOG_DISARMED     0
LOG_REPLAY       0
LOG_MAX_FILES    500
LOG_DARM_RATEMAX 0

# FFT分析
FFT_ENABLE      1
FFT_SAMPLEo_MODE 2


# ============================================================================
# PID控制参数
# ============================================================================

# -----------------------------
# 5.1 姿态角速度控制环（最内环）
# -----------------------------
# 说明：控制Roll/Pitch/Yaw的角速度，直接作用于电机输出
# 调试优先级：最高（必须先调稳）
# 调试方法：逐步增大P值直到出现高频震荡，回退20%

# --- Roll角速度环 ---
ATC_RAT_RLL_P,0.04                # Roll角速度P
ATC_RAT_RLL_I,0.001                # Roll角速度I
ATC_RAT_RLL_D,0               # Roll角速度D

# --- Pitch角速度环 ---
ATC_RAT_PIT_P,0.04                # Pitch角速度P
ATC_RAT_PIT_I,0.001                # Pitch角速度I
ATC_RAT_PIT_D,0              # Pitch角速度D

# --- Yaw角速度环 ---
ATC_RAT_YAW_P,0.02                 # Yaw角速度P
ATC_RAT_YAW_I,0.001                # Yaw角速度I
ATC_RAT_YAW_D,0                    # Yaw角速度D


# -----------------------------
# 5.2 姿态角度控制环（中环）
# -----------------------------
# 说明：控制目标角度，输出角速度指令给内环
# 调试顺序：在角速度环稳定后调整
# 调试方法：从P=3.0开始，逐步增加到期望响应速度

# --- Roll角度环 ---
ATC_ANG_RLL_P,4.5                  # Roll角度P

# --- Pitch角度环 ---
ATC_ANG_PIT_P,4.5                  # Pitch角度P

# --- Yaw角度环 ---
ATC_ANG_YAW_P,4.5                  # Yaw角度P

# --- 整体姿态控制参数 ---
ATC_THR_MIX_MIN,0.1                # 油门混合最小
ATC_THR_MIX_MAX,0.5                # 油门混合最大
ATC_THR_MIX_MAN,0.1                # 油门混合手动
ATC_THR_G_BOOST,0                  # 油门G提升

# -----------------------------
# 5.3 位置速度控制环（外环）
# -----------------------------
# 调试顺序：最后调整（依赖内环稳定）
# 调试方法：先调速度环，再调位置环

# --- 水平位置环 ---
PSC_POSXY_P,1.0                    # 水平位置P

# --- 水平速度环 ---
PSC_VELXY_P,2.0                    # 水平速度P
PSC_VELXY_I,1.0                    # 水平速度I
PSC_VELXY_D,0.5                    # 水平速度D

# --- 垂直位置环（高度）---
PSC_POSZ_P,1.0                     # 垂直位置P

# --- 垂直速度环 ---
PSC_VELZ_P,5.0                     # 垂直速度P
PSC_VELZ_I,0                       # 垂直速度I
PSC_VELZ_D,0                       # 垂直速度D
PSC_VELZ_IMAX,1000                 # 垂直速度I最大
PSC_VELZ_FF,0                      # 垂直速度前馈
PSC_VELZ_FLTD,5.0                  # 垂直速度D滤波
PSC_VELZ_FLTE,5.0                  # 垂直速度E滤波

# --- 高度加速度环 ---
PSC_ACCZ_P,0.5                     # 高度加速度P
PSC_ACCZ_I,1.0                     # 高度加速度I
PSC_ACCZ_D,0                       # 高度加速度D
