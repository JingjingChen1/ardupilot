# chenjingjing
# ============================================================================
# SITL仿真专用物理参数（真机飞行时删除此部分）
# ============================================================================
# 说明：这些参数仅用于仿真环境，定义飞机的物理特性和传感器噪声
# 真机使用实际传感器数据，不需要这些参数

# --- 机体物理特性 ---
SIM_MASS,1.5                       # 机体质量(kg)
SIM_ROLL_INERTIA,0.0125            # 横滚惯性(kg*m^2)
SIM_PITCH_INERTIA,0.0125           # 俯仰惯性(kg*m^2)
SIM_YAW_INERTIA,0.0230             # 偏航惯性(kg*m^2)
SIM_WHEELBASE,0.5                  # 轴距(m)

# --- 重心位置（相对飞控） ---
SIM_CG_X,0.0                       # 重心X(m)
SIM_CG_Y,0.0                       # 重心Y(m)
SIM_CG_Z,0.02                      # 重心Z(m)

# --- 螺旋桨参数 ---
SIM_PROP_DIAMETER,9.5              # 螺旋桨直径(inch)
SIM_PROP_PITCH,4.5                 # 螺旋桨螺距(inch)

# --- 传感器噪声仿真（模拟真实传感器特性）---
SIM_ACC_RND,0.3                    # 加速度计噪声
SIM_GYR_RND,0.01                   # 陀螺仪噪声
SIM_BARO_RND,0.5                   # 气压计噪声
# SIM_BARO_DRIFT,0.02                # 气压计漂移
SIM_GPS_DELAY,200                  # GPS延迟(ms)
SIM_GPS_TYPE,1                     # GPS类型
SIM_GPS_NUMSATS,16                 # GPS卫星数
SIM_GPS_HACC,1.5                   # GPS水平精度(m)
SIM_GPS_VACC,2.5                   # GPS垂直精度(m)

# --- 电机仿真 ---
SIM_MOTOR_HOVER,0.35               # 悬停油门
SIM_ENGINE_MUL,1.0                 # 电机推力系数

# --- 气动阻力系数 ---
SIM_DRAG_X,0.08                    # X轴阻力
SIM_DRAG_Y,0.08                    # Y轴阻力
SIM_DRAG_Z,0.15                    # Z轴阻力

# --- 地面效应 ---
SIM_GND_EFFECT,1.0                 # 地面效应系数
SIM_GND_HGT,1.5                    # 地面效应高度(m)

# --- SITL电池仿真 ---
SIM_BATT_VOLTAGE,12.6              # 电池电压(V)
SIM_BATT_CAP_AH,10.0               # 电池容量(Ah)
SIM_BATT_RESISTANCE,0.01           # 电池内阻(ohm)

