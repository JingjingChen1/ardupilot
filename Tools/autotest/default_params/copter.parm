RCMAP_ROLL,1                       # Roll → 通道1
RCMAP_PITCH,2                      # Pitch → 通道2
RCMAP_THROTTLE,3                   # Throttle → 通道3
RCMAP_YAW,4                        # Yaw → 通道4

