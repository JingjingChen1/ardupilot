# ============================================================================
# 第二部分：传感器校准参数
# ============================================================================
# SITL仿真时使用模拟传感器数据
# 真机移植时必须重新校准，不可直接复用



# ============================================================================
# 第三部分：EKF融合参数（保留实机优化值）
# ============================================================================
# 说明：这些参数通过实机飞行日志分析得出，可作为同型号飞机的基准值

# --- EKF3核心参数 ---
EK3_ENABLE,1                       # 启用EKF3
EK3_PRIMARY,0                      # 主EKF索引
EK3_IMU_MASK,3                     # 使用IMU 1和2
EK3_CHECK_SCALE,100                # 检查比例
EK3_ERR_THRESH,0.2                 # 错误阈值
EK3_AFFINITY,0                     # 亲和性
EK3_LOG_LEVEL,2                    # 日志等级

# --- 传感器噪声参数（通过飞行日志优化）---
# 陀螺仪
EK3_GYRO_P_NSE,0.015               # 陀螺仪过程噪声
EK3_GBIAS_P_NSE,0.001              # 陀螺仪偏置过程噪声

# 加速度计
EK3_ACC_P_NSE,0.35                 # 加速度计过程噪声
EK3_ABIAS_P_NSE,0.02               # 加速度计偏置过程噪声
EK3_ACC_BIAS_LIM,1                 # 加速度计偏置限制

# 罗盘
EK3_MAG_M_NSE,0.05                 # 罗盘测量噪声
EK3_MAG_I_GATE,300                 # 罗盘创新门限
EK3_MAG_CAL,3                      # 罗盘校准
EK3_MAGE_P_NSE,0.001               # 罗盘外部过程噪声
EK3_MAGB_P_NSE,0.0001              # 罗盘偏置过程噪声
EK3_MAG_EF_LIM,50                  # 罗盘外部场限制
EK3_MAG_MASK,0                     # 罗盘掩码

# GPS/位置
EK3_POSNE_M_NSE,0.5                # GPS水平测量噪声
EK3_POS_I_GATE,500                 # 位置创新门限
EK3_GLITCH_RAD,25                  # GPS跳变半径
EK3_GPS_CHECK,31                   # GPS检查
EK3_GPS_VACC_MAX,0                 # GPS最大垂直精度

# 速度
EK3_VELNE_M_NSE,0.3                # 水平速度测量噪声
EK3_VELD_M_NSE,0.5                 # 垂直速度测量噪声
EK3_VEL_I_GATE,500                 # 速度创新门限

# 高度/气压计
EK3_ALT_M_NSE,2                    # 高度测量噪声
EK3_HGT_DELAY,60                   # 高度延迟
EK3_HGT_I_GATE,500                 # 高度创新门限

# 风速估计
EK3_WIND_P_NSE,0.2                 # 风速过程噪声
EK3_WIND_PSCALE,1                  # 风速比例

# Yaw角
EK3_YAW_M_NSE,0.5                  # Yaw测量噪声
EK3_YAW_I_GATE,300                 # Yaw创新门限

# --- 传感器融合源配置 ---
# 源1（主源，GPS）
EK3_SRC1_POSXY,3                   # 主源水平位置
EK3_SRC1_POSZ,1                    # 主源垂直位置
EK3_SRC1_VELXY,3                   # 主源水平速度
